# Copy this file to .env and update the model path for your PC.
WASTENET_MODEL_PATH=E:\\Waste_Sorting_Final\\models\\detection\\yolov8n_wastenet_public_assisted_best.pt
WASTENET_MODEL_ID=yolov8n-public-assisted
WASTENET_MODEL_LABEL=YOLOv8n Public-Assisted
WASTENET_DEVICE=auto
WASTENET_IMAGE_SIZE=640
WASTENET_YOLO_CONF=0.10
WASTENET_SORT_CONF=0.50
WASTENET_UNCERTAIN_CONF=0.30
WASTENET_STABLE_FRAMES=3
WASTENET_REVIEW_COOLDOWN=5
WASTENET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
